build/
build.dos/
dosbox-x/capture/

# Not redistributable / built elsewhere -- see docs/DOSBOX.md
dosbox-x/c/*.EXE
dosbox-x/c/*.exe
dosbox-x/c/*.COM
dosbox-x/c/*.com
dosbox-x/c/DOSYPP.*
dosbox-x/c/*.TTH
dosbox-x/c/*.NAM
dosbox-x/c/*.INI

*.o
*.a
*.dSYM/
.DS_Store

# v86 browser host: fetched engine, built images, download cache
web/vendor/
web/images/
web/build.json
.cache/

# Dropped in the working directory by running the client from the repo root.
/DOSYPP.TTH
/DOSYPP.NAM
/DOSYPP.INI
/DOSYPP.QUE
/DOSYPP.FAV
/DOSYPP.TTL
/DOSYPP.WAV
/FILES.XML
/FILES.BZ2
/PEERLIST.BZ2

# Generated by tools/makemod.py (make modules). Not committed: the tune is
# written by the build for the same reason third_party/ is fetched, and it
# is a test fixture rather than content.
/art/*.MOD

# Fetched, not vendored: libbzip2's sources (tools/fetchbzip2.sh), for the
# same reason Watt-32 and the packet drivers are fetched.
/third_party/

# A 40MB SoundFont, fetched by tools/fetchsf2.sh for DOSBox-X's FluidSynth.
/dosbox-x/sf2/
# What FluidSynth's file driver writes, if you run DOSBox-X with it.
fluidsynth.wav

# Working notes, not published: the phase plan and the running list. The
# source still cites them by name in places -- they are the reasoning
# behind decisions, kept out of the repository on purpose.
/IMPLEMENTATION_PLAN.md
/TODO.md

# Drawn by tools/mkfavicon.py (make favicon), for the same reason the
# module is: generated from a source in the repository rather than
# committed as bytes nobody can edit.
/web/favicon.ico
/web/favicon.png
